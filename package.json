{
  "name": "snapshot-relayer",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "build": "tsc",
    "dev": "nodemon src/index.ts",
    "start": "node dist/src/index.js",
    "start:test": "dotenv -e test/.env.test yarn dev",
    "test": "PORT=3003 start-server-and-test 'yarn start:test' http://localhost:3003/api 'dotenv -e test/.env.test jest --runInBand test'",
    "test:e2e": "PORT=3003 start-server-and-test 'yarn start:test' http://localhost:3003/api 'dotenv -e test/.env.test jest --runInBand --collectCoverage=false test/e2e/'",
    "test:unit": "jest test/unit/"
  },
  "prettier": "@snapshot-labs/prettier-config",
  "dependencies": {
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/bytes": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/hash": "^5.8.0",
    "@snapshot-labs/snapshot-metrics": "^1.5.0",
    "@snapshot-labs/snapshot-sentry": "^3.1.0",
    "@snapshot-labs/snapshot.js": "^0.14.26",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "pg": "^8.13.1",
    "semver": "^7.8.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@snapshot-labs/eslint-config": "^0.1.1",
    "@snapshot-labs/prettier-config": "^0.1.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "jest": "^29.7.0",
    "jest-environment-node-single-context": "^29.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "start-server-and-test": "^2.1.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
